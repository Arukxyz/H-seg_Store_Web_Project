ght="1235" as="geometry"/></mxCell><UserObject label="&lt;b&gt;CU-11&lt;/b&gt;&lt;br&gt;Iniciar y cerrar sesión" tooltip="CU-11 · Iniciar y cerrar sesión&#10;RF: RF01&#10;Ruta: GET /login · POST /login · POST /logout&#10;Vista: login.html&#10;Controlador: SecurityConfig (formLogin) → ClienteDetailsService&#10;Tablas: cliente (lee)&#10;Lógica: Ingresa email y contraseña; al validarse, el menú muestra su nombre y se habilitan la compra y su cuenta. El carrito armado como visitante se conserva." rf="RF01" ruta="GET /login · POST /login · POST /logout" vista="login.html" controlador="SecurityConfig (formLogin) → ClienteDetailsService" tablas="cliente (lee)" id="cli-n4"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF0E8;strokeColor=#A8501E;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="cli-n3"><mxGeometry x="30" y="90" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="cli-n5" value="&lt;b&gt;CU-11 · Iniciar y cerrar sesión&lt;/b&gt;&lt;br&gt;&lt;b&gt;RF:&lt;/b&gt; RF01&lt;br&gt;&lt;b&gt;Vista:&lt;/b&gt; login.html&lt;br&gt;&lt;b&gt;Ruta:&lt;/b&gt; GET /login · POST /login · POST /logout&lt;br&gt;&lt;b&gt;Controlador:&lt;/b&gt; SecurityConfig (formLogin) → ClienteDetailsService&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; cliente (lee)&lt;br&gt;&lt;b&gt;Lógica:&lt;/b&gt; Ingresa email y contraseña; al validarse, el menú muestra su nombre y se habilitan la compra y su cuenta. El carrito armado como visitante se conserva." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="860" y="150" width="540" height="122" as="geometry"/></mxCell><mxCell id="cli-e6" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;" edge="1" parent="1" source="cli-n5" target="cli-n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b
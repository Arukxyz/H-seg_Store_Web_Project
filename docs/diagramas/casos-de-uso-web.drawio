ative="1" as="geometry"></mxGeometry></mxCell><mxCell id="db-e92" value="" style="endArrow=none;html=1;strokeColor=#4A2E20;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n71" target="db-n68"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="6 · Servicio de correo" id="mail"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="mail-n1" value="Servicio de correo · notificaciones que envía el portal" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="mail-n2" value="&lt;b&gt;Actor Servicio de correo:&lt;/b&gt; Servidor SMTP usado por JavaMailSender para las notificaciones." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#7A6152;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="1300" height="24" as="geometry"/></mxCell><mxCell id="mail-n3" value="Portal web HÖSÉG" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fillColor=#FFFFFF;strokeColor=#2C1810;fontColor=#2C1810;container=1;collapsible=0;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="600" y="90" width="330" height="686" as="geometry"/></mxCell><mxCell id="mail-n4" value="Correos transaccionales" style="text;html=1;align=left;verticalAlign=middle;fontStyle=3;fontSize=12;fontColor=#7A6152;" vertex="1" parent="mail-n3"><mxGeometry x="20" y="28" width="300" height="24" as="geometry"/></mxCell><mxCell id="mail-n5" value="&lt;b&gt;Correos transaccionales&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontStyle=3;fontSize=12;fontColor=#7A6152;" vertex="1" parent="1"><mxGeometry x="20" y="118" width="540" height="24" as="geometry"/></mxCell><UserObject label="&lt;b&gt;CU-07&lt;/b&gt;&lt;br&gt;Registrarse como cliente" tooltip="CU-07 · Registrarse como cliente&#10;RF: RF01&#10;Ruta: GET /registro · POST /registro&#10;Vista: registro.html&#10;Controlador: AuthController → ClienteService (DTO RegistroClienteForm: @NotBlank, @Email, @Size)&#10;Tablas: cliente (lee, inserta)&#10;Lógica: Completa nombre, apellido, documento, email, teléfono, dirección y contraseña; los errores se muestran junto a cada campo (th:errors). Si su email ya existe por una compra anterior, completa ese registro." rf="RF01" ruta="GET /registro · POST /registro" vista="registro.html" controlador="AuthController → ClienteService (DTO RegistroClienteForm: @NotBlank, @Email, @Size)" tablas="cliente (lee, inserta)" id="mail-n6"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="mail-n3"><mxGeometry x="40" y="77" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="mail-n7" value="&lt;b&gt;CU-07 · Registrarse como cliente&lt;/b&gt;&lt;br&gt;&lt;b&gt;Correo:&lt;/b&gt; Bienvenida&lt;br&gt;&lt;b&gt;Para:&lt;/b&gt; El nuevo cliente&lt;br&gt;&lt;b&gt;Contenido:&lt;/b&gt; Confirma la cuenta y enlaza a la tienda y a la consulta de impacto.&lt;br&gt;&lt;b&gt;Plantilla:&lt;/b&gt; templates/correo/bienvenida.html&lt;br&gt;&lt;b&gt;Envío:&lt;/b&gt; CorreoService → JavaMailSender (spring-boot-starter-mail)" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="540" height="96" as="geometry"/></mxCell><mxCell id="mail-e8" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mail-n7" target="mail-n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-08&lt;/b&gt;&lt;br&gt;Enviar mensaje de contacto" tooltip="CU-08 · Enviar mensaje de contacto&#10;RF: RF12*&#10;Ruta: GET /contacto · POST /contacto&#10;Vista: contacto.html&#10;Controlador: ContactoController → ContactoService (DTO MensajeContactoForm)&#10;Tablas: mensaje_contacto* (inserta)&#10;Lógica: Escribe su nombre, email, asunto y mensaje (tallas, pedidos corporativos, personal shopper) y recibe un acuse de recibo." rf="RF12*" ruta="GET /contacto · POST /contacto" vista="contacto.html" controlador="ContactoController → ContactoService (DTO MensajeContactoForm)" tablas="mensaje_contacto* (inserta)" id="mail-n9"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="mail-n3"><mxGeometry x="40" y="193" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="mail-n10" value="&lt;b&gt;CU-08 · Enviar mensaje de contacto&lt;/b&gt;&lt;br&gt;&lt;b&gt;Correo:&lt;/b&gt; Acuse de recibo + aviso interno&lt;br&gt;&lt;b&gt;Para:&lt;/b&gt; El visitante y el buzón del equipo&lt;br&gt;&lt;b&gt;Contenido:&lt;/b&gt; Al visitante: su mensaje fue recibido. Al equipo: datos del mensaje para atenderlo.&lt;br&gt;&lt;b&gt;Plantilla:&lt;/b&gt; templates/correo/contacto-acuse.html · contacto-aviso.html&lt;br&gt;&lt;b&gt;Envío:&lt;/b&gt; CorreoService → JavaMailSender (spring-boot-starter-mail)" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="266" width="540" height="96" as="geometry"/></mxCell><mxCell id="mail-e11" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mail-n10" target="mail-n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-09&lt;/b&gt;&lt;br&gt;Suscribirse al boletín Changemaker" tooltip="CU-09 · Suscribirse al boletín Changemaker&#10;RF: RF12*&#10;Ruta: POST /boletin&#10;Vista: fragments/footer.html (formulario)&#10;Controlador: BoletinController → BoletinService&#10;Tablas: suscriptor_boletin* (lee, inserta)&#10;Lógica: Deja su email en el pie de página para recibir campañas, lanzamientos e informes de impacto." rf="RF12*" ruta="POST /boletin" vista="fragments/footer.html (formulario)" controlador="BoletinController → BoletinService" tablas="suscriptor_boletin* (lee, inserta)" id="mail-n12"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="mail-n3"><mxGeometry x="40" y="309" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="mail-n13" value="&lt;b&gt;CU-09 · Suscribirse al boletín Changemaker&lt;/b&gt;&lt;br&gt;&lt;b&gt;Correo:&lt;/b&gt; Confirmación de suscripción&lt;br&gt;&lt;b&gt;Para:&lt;/b&gt; El suscriptor&lt;br&gt;&lt;b&gt;Contenido:&lt;/b&gt; Bienvenida al boletín y enlace para darse de baja.&lt;br&gt;&lt;b&gt;Plantilla:&lt;/b&gt; templates/correo/boletin-bienvenida.html&lt;br&gt;&lt;b&gt;Envío:&lt;/b&gt; CorreoService → JavaMailSender (spring-boot-starter-mail)" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="382" width="540" height="96" as="geometry"/></mxCell><mxCell id="mail-e14" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mail-n13" target="mail-n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-12&lt;/b&gt;&lt;br&gt;Recuperar contraseña" tooltip="CU-12 · Recuperar contraseña&#10;RF: RF01&#10;Ruta: GET/POST /recuperar · GET/POST /restablecer?token=&#10;Vista: recuperar.html · restablecer.html&#10;Controlador: RecuperacionController → ClienteService&#10;Tablas: cliente (lee, actualiza) · token_recuperacion* (inserta, actualiza)&#10;Lógica: Pide un enlace con su email, lo abre desde su correo y define una contraseña nueva." rf="RF01" ruta="GET/POST /recuperar · GET/POST /restablecer?token=" vista="recuperar.html · restablecer.html" controlador="RecuperacionController → ClienteService" tablas="cliente (lee, actualiza) · token_recuperacion* (inserta, actualiza)" id="mail-n15"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF0E8;strokeColor=#A8501E;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="mail-n3"><mxGeometry x="40" y="432" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="mail-n16" value="&lt;b&gt;CU-12 · Recuperar contraseña&lt;/b&gt;&lt;br&gt;&lt;b&gt;Correo:&lt;/b&gt; Enlace de restablecimiento&lt;br&gt;&lt;b&gt;Para:&lt;/b&gt; El cliente que lo solicitó&lt;br&gt;&lt;b&gt;Contenido:&lt;/b&gt; Enlace de un solo uso, válido 30 minutos. Si el email no existe, no se envía nada y la pantalla responde igual.&lt;br&gt;&lt;b&gt;Plantilla:&lt;/b&gt; templates/correo/recuperar.html&lt;br&gt;&lt;b&gt;Envío:&lt;/b&gt; CorreoService → JavaMailSender (spring-boot-starter-mail)" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="498" width="540" height="109" as="geometry"/></mxCell><mxCell id="mail-e17" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mail-n16" target="mail-n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-15&lt;/b&gt;&lt;br&gt;Confirmar compra" tooltip="CU-15 · Confirmar compra&#10;RF: RF02, RF04&#10;Ruta: POST /carrito/confirmar (exige sesión)&#10;Vista: carrito.html → compra-exito.html&#10;Controlador: CarritoController → VentaService (@Transactional)&#10;Tablas: venta (inserta) · detalle_venta (inserta) · donacion (inserta) · producto (lee) · cliente (lee)&#10;Lógica: Confirma su carrito; en una sola transacción se registran la venta, sus líneas y las donaciones 1:1. Se vacía el carrito y se muestra el código de boleta. El pedido queda PENDIENTE hasta confirmarse el pago: la web no descuenta stock." rf="RF02, RF04" ruta="POST /carrito/confirmar (exige sesión)" vista="carrito.html → compra-exito.html" controlador="CarritoController → VentaService (@Transactional)" tablas="venta (inserta) · detalle_venta (inserta) · donacion (inserta) · producto (lee) · cliente (lee)" id="mail-n18"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF0E8;strokeColor=#A8501E;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="mail-n3"><mxGeometry x="40" y="560" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="mail-n19" value="&lt;b&gt;CU-15 · Confirmar compra&lt;/b&gt;&lt;br&gt;&lt;b&gt;Correo:&lt;/b&gt; Pedido recibido&lt;br&gt;&lt;b&gt;Para:&lt;/b&gt; El cliente que compró&lt;br&gt;&lt;b&gt;Contenido:&lt;/b&gt; Código WEB-nnnnnn, detalle, impacto generado y enlace a la consulta de impacto. Se envía después del commit: si el correo falla, la compra no se revierte.&lt;br&gt;&lt;b&gt;Plantilla:&lt;/b&gt; templates/correo/pedido-recibido.html&lt;br&gt;&lt;b&gt;Envío:&lt;/b&gt; CorreoService → JavaMailSender (spring-boot-starter-mail)" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="627" width="540" height="109" as="geometry"/></mxCell><mxCell id="mail-e20" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mail-n19" target="mail-n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mail-n21" value="«sistema externo»&lt;br&gt;&lt;b&gt;Servicio de correo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SMTP · JavaMailSender&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE6D6;strokeColor=#4A2E20;fontColor=#2C1810;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="403" width="180" height="74" as="geometry"/></mxCell><mxCell id="mail-e22" value="" style="endArrow=none;html=1;strokeColor=#4A2E20;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mail-n21" target="mail-n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mail-e23" value="" style="endArrow=none;html=1;strokeColor=#4A2E20;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mail-n21" target="mail-n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mail-e24" value="" style="endArrow=none;html=1;strokeColor=#4A2E20;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mail-n21" target="mail-n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mail-e25" value="" style="endArrow=none;html=1;strokeColor=#4A2E20;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mail-n21" target="mail-n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mail-e26" value="" style="endArrow=none;html=1;strokeColor=#4A2E20;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mail-n21" target="mail-n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>

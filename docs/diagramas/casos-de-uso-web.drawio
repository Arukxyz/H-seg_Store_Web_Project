<mxfile host="app.diagrams.net" agent="hoseg-web" version="24.7.17"><diagram name="1 · General" id="gen"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="gen-n1" value="Diagrama general de casos de uso · Portal web HÖSÉG" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="gen-lim" value="Portal web HÖSÉG · Spring Boot 3 + Thymeleaf + Supabase" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fillColor=#FFFFFF;strokeColor=#2C1810;fontColor=#2C1810;container=1;collapsible=0;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="230" y="90" width="640" height="2122" as="geometry"/></mxCell><mxCell id="gen-n2" value="① Navegación y consulta pública" style="text;html=1;align=left;verticalAlign=middle;fontStyle=3;fontSize=12;fontColor=#7A6152;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="48" width="540" height="24" as="geometry"/></mxCell><mxCell id="gen-n3" value="② Cuenta y compra del cliente" style="text;html=1;align=left;verticalAlign=middle;fontStyle=3;fontSize=12;fontColor=#7A6152;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="940" width="540" height="24" as="geometry"/></mxCell><mxCell id="gen-n4" value="③ Administración del portal" style="text;html=1;align=left;verticalAlign=middle;fontStyle=3;fontSize=12;fontColor=#7A6152;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="1590" width="540" height="24" as="geometry"/></mxCell><UserObject label="&lt;b&gt;CU-01&lt;/b&gt;&lt;br&gt;Explorar página principal" tooltip="CU-01 · Explorar página principal&#10;RF: RF04&#10;Ruta: GET /&#10;Vista: index.html (fragmentos navbar, footer, product-card)&#10;Controlador: HomeController → CatalogoService, ImpactoService&#10;Tablas: producto (lee) · donacion (lee) · lote_donacion (lee) · comunidad (lee) · venta (lee)&#10;Lógica: Ve el banner de identidad, el carrusel de productos destacados con su badge «1 abrigo» / «1 árbol», las cifras de impacto entregado y las comunidades beneficiadas." rf="RF04" ruta="GET /" vista="index.html (fragmentos navbar, footer, product-card)" controlador="HomeController → CatalogoService, ImpactoService" tablas="producto (lee) · donacion (lee) · lote_donacion (lee) · comunidad (lee) · venta (lee)" id="gen-n5"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="80" width="240" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-02&lt;/b&gt;&lt;br&gt;Explorar catálogo de productos" tooltip="CU-02 · Explorar catálogo de productos&#10;RF: RF03&#10;Ruta: GET /tienda&#10;Vista: tienda.html&#10;Controlador: TiendaController → CatalogoService&#10;Tablas: producto (lee)&#10;Lógica: Recorre casacas, accesorios y café agrupados por nombre, con precio, tallas y compromiso de impacto; los productos sin stock comercial se muestran como «Agotado»." rf="RF03" ruta="GET /tienda" vista="tienda.html" controlador="TiendaController → CatalogoService" tablas="producto (lee)" id="gen-n6"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="158" width="240" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-02.1&lt;/b&gt;&lt;br&gt;Filtrar por categoría, colección o impacto" tooltip="CU-02.1 · Filtrar por categoría, colección o impacto&#10;RF: RF03&#10;Ruta: GET /tienda?categoria=&amp;coleccion=&amp;impacto=&#10;Vista: tienda.html (panel de filtros)&#10;Controlador: TiendaController → CatalogoService&#10;Tablas: producto (lee)&#10;Lógica: Acota el listado por categoría (Casacas, Accesorios, Café), colección (Älpafill, Comunidad, Urbana) o tipo de impacto (abrigo / árbol)." rf="RF03" ruta="GET /tienda?categoria=&amp;coleccion=&amp;impacto=" vista="tienda.html (panel de filtros)" controlador="TiendaController → CatalogoService" tablas="producto (lee)" id="gen-n7"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=10;" vertex="1" parent="gen-lim"><mxGeometry x="370" y="158" width="220" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-03&lt;/b&gt;&lt;br&gt;Ver detalle de producto" tooltip="CU-03 · Ver detalle de producto&#10;RF: RF03, RF04&#10;Ruta: GET /tienda/{codigo}&#10;Vista: producto-detalle.html&#10;Controlador: TiendaController → CatalogoService&#10;Tablas: producto (lee)&#10;Lógica: Ve fotos, descripción, precio y las tallas disponibles (cada talla es un código distinto); elige talla y cantidad y ve qué donación genera su compra." rf="RF03, RF04" ruta="GET /tienda/{codigo}" vista="producto-detalle.html" controlador="TiendaController → CatalogoService" tablas="producto (lee)" id="gen-n8"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="236" width="240" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-03.1&lt;/b&gt;&lt;br&gt;Consultar guía de tallas" tooltip="CU-03.1 · Consultar guía de tallas&#10;RF: —&#10;Ruta: Sin petición al servidor&#10;Vista: producto-detalle.html (modal Bootstrap)&#10;Controlador: —&#10;Tablas: Ninguna&#10;Lógica: Abre la tabla comparativa de medidas S · M · L · XL antes de elegir talla." rf="—" ruta="Sin petición al servidor" vista="producto-detalle.html (modal Bootstrap)" controlador="—" tablas="Ninguna" id="gen-n9"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=10;" vertex="1" parent="gen-lim"><mxGeometry x="370" y="236" width="220" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-04&lt;/b&gt;&lt;br&gt;Gestionar carrito de compras" tooltip="CU-04 · Gestionar carrito de compras&#10;RF: RF02&#10;Ruta: GET /carrito · POST /carrito/agregar · POST /carrito/actualizar · POST /carrito/quitar&#10;Vista: carrito.html&#10;Controlador: CarritoController → CarritoService (@SessionScope)&#10;Tablas: producto (lee)&#10;Lógica: Agrega, cambia la cantidad o quita prendas; ve subtotales, total y el impacto que generará. No necesita cuenta: el carrito vive en la sesión HTTP." rf="RF02" ruta="GET /carrito · POST /carrito/agregar · POST /carrito/actualizar · POST /carrito/quitar" vista="carrito.html" controlador="CarritoController → CarritoService (@SessionScope)" tablas="producto (lee)" id="gen-n10"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="314" width="240" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-05&lt;/b&gt;&lt;br&gt;Conocer Höség Café" tooltip="CU-05 · Conocer Höség Café&#10;RF: RF04, RF11*&#10;Ruta: GET /cafe&#10;Vista: cafe.html&#10;Controlador: CafeController → CafeService&#10;Tablas: cafe_carta* (lee) · cafe_local* (lee) · contenido_web* (lee) · producto (lee)&#10;Lógica: Conoce la propuesta «por cada taza, un árbol» junto a la ONG Pachamama Raymi; revisa la carta, los locales y horarios, y puede ir a comprar café en grano a la tienda (categoría Café, genera 1 árbol)." rf="RF04, RF11*" ruta="GET /cafe" vista="cafe.html" controlador="CafeController → CafeService" tablas="cafe_carta* (lee) · cafe_local* (lee) · contenido_web* (lee) · producto (lee)" id="gen-n11"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="392" width="240" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-06&lt;/b&gt;&lt;br&gt;Conocer la empresa y su triple impacto" tooltip="CU-06 · Conocer la empresa y su triple impacto&#10;RF: RF04, RF11*&#10;Ruta: GET /nosotros · GET /politica-rsu · GET /terminos&#10;Vista: nosotros.html · politica-rsu.html · terminos.html&#10;Controlador: InstitucionalController → ContenidoService, ImpactoService&#10;Tablas: contenido_web* (lee) · comunidad (lee) · ong (lee)&#10;Lógica: Lee la historia de la marca, los modelos Buy One, Give One y Buy One, Plant One, las comunidades y la ONG aliada, y las políticas de responsabilidad social." rf="RF04, RF11*" ruta="GET /nosotros · GET /politica-rsu · GET /terminos" vista="nosotros.html · politica-rsu.html · terminos.html" controlador="InstitucionalController → ContenidoService, ImpactoService" tablas="contenido_web* (lee) · comunidad (lee) · ong (lee)" id="gen-n12"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="470" width="240" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-07&lt;/b&gt;&lt;br&gt;Registrarse como cliente" tooltip="CU-07 · Registrarse como cliente&#10;RF: RF01&#10;Ruta: GET /registro · POST /registro&#10;Vista: registro.html&#10;Controlador: AuthController → ClienteService (DTO RegistroClienteForm: @NotBlank, @Email, @Size)&#10;Tablas: cliente (lee, inserta)&#10;Lógica: Completa nombre, apellido, documento, email, teléfono, dirección y contraseña; los errores se muestran junto a cada campo (th:errors). Si su email ya existe por una compra anterior, completa ese registro." rf="RF01" ruta="GET /registro · POST /registro" vista="registro.html" controlador="AuthController → ClienteService (DTO RegistroClienteForm: @NotBlank, @Email, @Size)" tablas="cliente (lee, inserta)" id="gen-n13"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="548" width="240" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-08&lt;/b&gt;&lt;br&gt;Enviar mensaje de contacto" tooltip="CU-08 · Enviar mensaje de contacto&#10;RF: RF12*&#10;Ruta: GET /contacto · POST /contacto&#10;Vista: contacto.html&#10;Controlador: ContactoController → ContactoService (DTO MensajeContactoForm)&#10;Tablas: mensaje_contacto* (inserta)&#10;Lógica: Escribe su nombre, email, asunto y mensaje (tallas, pedidos corporativos, personal shopper) y recibe un acuse de recibo." rf="RF12*" ruta="GET /contacto · POST /contacto" vista="contacto.html" controlador="ContactoController → ContactoService (DTO MensajeContactoForm)" tablas="mensaje_contacto* (inserta)" id="gen-n14"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="626" width="240" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-09&lt;/b&gt;&lt;br&gt;Suscribirse al boletín Changemaker" tooltip="CU-09 · Suscribirse al boletín Changemaker&#10;RF: RF12*&#10;Ruta: POST /boletin&#10;Vista: fragments/footer.html (formulario)&#10;Controlador: BoletinController → BoletinService&#10;Tablas: suscriptor_boletin* (lee, inserta)&#10;Lógica: Deja su email en el pie de página para recibir campañas, lanzamientos e informes de impacto." rf="RF12*" ruta="POST /boletin" vista="fragments/footer.html (formulario)" controlador="BoletinController → BoletinService" tablas="suscriptor_boletin* (lee, inserta)" id="gen-n15"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="704" width="240" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-10&lt;/b&gt;&lt;br&gt;Consultar impacto por boleta" tooltip="CU-10 · Consultar impacto por boleta&#10;RF: RF04, RF06&#10;Ruta: GET /consulta-impacto?boleta=WEB-000110 · GET /api/impacto?boleta= (AJAX)&#10;Vista: consulta-impacto.html&#10;Controlador: ConsultaImpactoController → ImpactoService&#10;Tablas: venta (lee) · detalle_venta (lee) · donacion (lee) · lote_donacion (lee) · comunidad (lee) · ong (lee)&#10;Lógica: Ingresa el código de su boleta y ve cada abrigo o árbol que generó, su estado (Pendiente de asignar → Lote asignado → Entregada) y la comunidad beneficiada." rf="RF04, RF06" ruta="GET /consulta-impacto?boleta=WEB-000110 · GET /api/impacto?boleta= (AJAX)" vista="consulta-impacto.html" controlador="ConsultaImpactoController → ImpactoService" tablas="venta (lee) · detalle_venta (lee) · donacion (lee) · lote_donacion (lee) · comunidad (lee) · ong (lee)" id="gen-n16"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="782" width="240" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-10.1&lt;/b&gt;&lt;br&gt;Acceder desde el QR de la boleta" tooltip="CU-10.1 · Acceder desde el QR de la boleta&#10;RF: RF06&#10;Ruta: GET /consulta-impacto?donacion={id}&#10;Vista: consulta-impacto.html&#10;Controlador: ConsultaImpactoController → ImpactoService&#10;Tablas: donacion (lee) · lote_donacion (lee) · comunidad (lee)&#10;Lógica: Escanea el QR impreso en su boleta y llega directo al estado de esa donación, sin escribir el código." rf="RF06" ruta="GET /consulta-impacto?donacion={id}" vista="consulta-impacto.html" controlador="ConsultaImpactoController → ImpactoService" tablas="donacion (lee) · lote_donacion (lee) · comunidad (lee)" id="gen-n17"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=10;" vertex="1" parent="gen-lim"><mxGeometry x="370" y="852" width="220" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-11&lt;/b&gt;&lt;br&gt;Iniciar y cerrar sesión" tooltip="CU-11 · Iniciar y cerrar sesión&#10;RF: RF01&#10;Ruta: GET /login · POST /login · POST /logout&#10;Vista: login.html&#10;Controlador: SecurityConfig (formLogin) → ClienteDetailsService&#10;Tablas: cliente (lee)&#10;Lógica: Ingresa email y contraseña; al validarse, el menú muestra su nombre y se habilitan la compra y su cuenta. El carrito armado como visitante se conserva." rf="RF01" ruta="GET /login · POST /login · POST /logout" vista="login.html" controlador="SecurityConfig (formLogin) → ClienteDetailsService" tablas="cliente (lee)" id="gen-n18"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF0E8;strokeColor=#A8501E;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="980" width="240" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-12&lt;/b&gt;&lt;br&gt;Recuperar contraseña" tooltip="CU-12 · Recuperar contraseña&#10;RF: RF01&#10;Ruta: GET/POST /recuperar · GET/POST /restablecer?token=&#10;Vista: recuperar.html · restablecer.html&#10;Controlador: RecuperacionController → ClienteService&#10;Tablas: cliente (lee, actualiza) · token_recuperacion* (inserta, actualiza)&#10;Lógica: Pide un enlace con su email, lo abre desde su correo y define una contraseña nueva." rf="RF01" ruta="GET/POST /recuperar · GET/POST /restablecer?token=" vista="recuperar.html · restablecer.html" controlador="RecuperacionController → ClienteService" tablas="cliente (lee, actualiza) · token_recuperacion* (inserta, actualiza)" id="gen-n19"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF0E8;strokeColor=#A8501E;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="1058" width="240" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-13&lt;/b&gt;&lt;br&gt;Consultar mis pedidos e impacto" tooltip="CU-13 · Consultar mis pedidos e impacto&#10;RF: RF04, RF06&#10;Ruta: GET /cuenta · GET /cuenta/pedidos/{codigo}&#10;Vista: cuenta.html (pestaña Pedidos) · pedido-detalle.html&#10;Controlador: CuentaController → VentaService, ImpactoService&#10;Tablas: venta (lee) · detalle_venta (lee) · donacion (lee) · lote_donacion (lee) · comunidad (lee)&#10;Lógica: Revisa su historial de compras con su estado (Pendiente, Pagado, Anulado), el detalle de cada una y el recorrido de cada donación hasta su comunidad." rf="RF04, RF06" ruta="GET /cuenta · GET /cuenta/pedidos/{codigo}" vista="cuenta.html (pestaña Pedidos) · pedido-detalle.html" controlador="CuentaController → VentaService, ImpactoService" tablas="venta (lee) · detalle_venta (lee) · donacion (lee) · lote_donacion (lee) · comunidad (lee)" id="gen-n20"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF0E8;strokeColor=#A8501E;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="1136" width="240" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-14&lt;/b&gt;&lt;br&gt;Actualizar datos de cuenta" tooltip="CU-14 · Actualizar datos de cuenta&#10;RF: RF01&#10;Ruta: POST /cuenta/datos · POST /cuenta/contrasena&#10;Vista: cuenta.html (pestaña Mis datos)&#10;Controlador: CuentaController → ClienteService (DTO DatosClienteForm)&#10;Tablas: cliente (actualiza)&#10;Lógica: Edita nombre, teléfono y dirección de envío; cambia su contraseña confirmando la actual. El email es su usuario y no se edita aquí." rf="RF01" ruta="POST /cuenta/datos · POST /cuenta/contrasena" vista="cuenta.html (pestaña Mis datos)" controlador="CuentaController → ClienteService (DTO DatosClienteForm)" tablas="cliente (actualiza)" id="gen-n21"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF0E8;strokeColor=#A8501E;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="1214" width="240" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-15&lt;/b&gt;&lt;br&gt;Confirmar compra" tooltip="CU-15 · Confirmar compra&#10;RF: RF02, RF04&#10;Ruta: POST /carrito/confirmar (exige sesión)&#10;Vista: carrito.html → compra-exito.html&#10;Controlador: CarritoController → VentaService (@Transactional)&#10;Tablas: venta (inserta) · detalle_venta (inserta) · donacion (inserta) · producto (lee) · cliente (lee)&#10;Lógica: Confirma su carrito; en una sola transacción se registran la venta, sus líneas y las donaciones 1:1. Se vacía el carrito y se muestra el código de boleta. El pedido queda PENDIENTE hasta confirmarse el pago: la web no descuenta stock." rf="RF02, RF04" ruta="POST /carrito/confirmar (exige sesión)" vista="carrito.html → compra-exito.html" controlador="CarritoController → VentaService (@Transactional)" tablas="venta (inserta) · detalle_venta (inserta) · donacion (inserta) · producto (lee) · cliente (lee)" id="gen-n22"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF0E8;strokeColor=#A8501E;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="1292" width="240" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-15.1&lt;/b&gt;&lt;br&gt;Validar carrito y stock" tooltip="CU-15.1 · Validar carrito y stock&#10;RF: RF03&#10;Ruta: Dentro de POST /carrito/confirmar&#10;Vista: carrito.html (mensajes por línea)&#10;Controlador: VentaService&#10;Tablas: producto (lee)&#10;Lógica: Rechaza el carrito vacío, los productos inactivos u ocultos y las cantidades mayores al stock comercial disponible, con un mensaje por línea." rf="RF03" ruta="Dentro de POST /carrito/confirmar" vista="carrito.html (mensajes por línea)" controlador="VentaService" tablas="producto (lee)" id="gen-n23"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF0E8;strokeColor=#A8501E;fontColor=#2C1810;strokeWidth=1.5;fontSize=10;" vertex="1" parent="gen-lim"><mxGeometry x="370" y="1362" width="220" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-15.2&lt;/b&gt;&lt;br&gt;Generar código de comprobante" tooltip="CU-15.2 · Generar código de comprobante&#10;RF: RF02&#10;Ruta: Dentro de POST /carrito/confirmar&#10;Vista: compra-exito.html&#10;Controlador: VentaService&#10;Tablas: seq_comprobante_web (nextval) · venta (inserta)&#10;Lógica: Asigna el siguiente código WEB-nnnnnn con la secuencia de la base, sin calcular máximos, para que dos compras simultáneas nunca repitan número." rf="RF02" ruta="Dentro de POST /carrito/confirmar" vista="compra-exito.html" controlador="VentaService" tablas="seq_comprobante_web (nextval) · venta (inserta)" id="gen-n24"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF0E8;strokeColor=#A8501E;fontColor=#2C1810;strokeWidth=1.5;fontSize=10;" vertex="1" parent="gen-lim"><mxGeometry x="370" y="1432" width="220" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-15.3&lt;/b&gt;&lt;br&gt;Registrar compromiso 1:1" tooltip="CU-15.3 · Registrar compromiso 1:1&#10;RF: RF04&#10;Ruta: Dentro de POST /carrito/confirmar&#10;Vista: compra-exito.html (resumen de impacto)&#10;Controlador: VentaService&#10;Tablas: producto (lee) · donacion (inserta)&#10;Lógica: Por cada línea con compromiso crea una donación PENDIENTE: 1 abrigo por casaca o chaleco, 1 árbol por accesorio o café, tantas unidades como las compradas." rf="RF04" ruta="Dentro de POST /carrito/confirmar" vista="compra-exito.html (resumen de impacto)" controlador="VentaService" tablas="producto (lee) · donacion (inserta)" id="gen-n25"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF0E8;strokeColor=#A8501E;fontColor=#2C1810;strokeWidth=1.5;fontSize=10;" vertex="1" parent="gen-lim"><mxGeometry x="370" y="1502" width="220" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-16&lt;/b&gt;&lt;br&gt;Iniciar sesión administrativa" tooltip="CU-16 · Iniciar sesión administrativa&#10;RF: RF01&#10;Ruta: GET /admin/login · POST /admin/login · POST /admin/logout&#10;Vista: admin/login.html&#10;Controlador: SecurityConfig (cadena /admin/**) → UsuarioDetailsService&#10;Tablas: usuario (lee)&#10;Lógica: El personal de Höség con rol ADMINISTRADOR entra al panel del portal. Las cuentas de cliente no tienen acceso a /admin." rf="RF01" ruta="GET /admin/login · POST /admin/login · POST /admin/logout" vista="admin/login.html" controlador="SecurityConfig (cadena /admin/**) → UsuarioDetailsService" tablas="usuario (lee)" id="gen-n26"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F0E8;strokeColor=#5A7A5C;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="1630" width="240" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-17&lt;/b&gt;&lt;br&gt;Gestionar destacados y visibilidad web" tooltip="CU-17 · Gestionar destacados y visibilidad web&#10;RF: RF11*&#10;Ruta: GET /admin/catalogo · POST /admin/catalogo/{codigo}&#10;Vista: admin/catalogo.html&#10;Controlador: AdminCatalogoController → CatalogoService&#10;Tablas: producto (lee, actualiza)&#10;Lógica: Elige qué productos aparecen en el carrusel de la Home y oculta de la tienda los que no deben venderse en línea." rf="RF11*" ruta="GET /admin/catalogo · POST /admin/catalogo/{codigo}" vista="admin/catalogo.html" controlador="AdminCatalogoController → CatalogoService" tablas="producto (lee, actualiza)" id="gen-n27"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F0E8;strokeColor=#5A7A5C;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="1708" width="240" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-18&lt;/b&gt;&lt;br&gt;Gestionar Höség Café" tooltip="CU-18 · Gestionar Höség Café&#10;RF: RF11*&#10;Ruta: GET/POST /admin/cafe/carta · GET/POST /admin/cafe/locales&#10;Vista: admin/cafe.html&#10;Controlador: AdminCafeController → CafeService&#10;Tablas: cafe_carta* (inserta, actualiza) · cafe_local* (inserta, actualiza) · contenido_web* (actualiza)&#10;Lógica: Mantiene la carta (bebidas, precios, disponibilidad), los locales y horarios, y la cifra de árboles sembrados por el café que se publica en /cafe." rf="RF11*" ruta="GET/POST /admin/cafe/carta · GET/POST /admin/cafe/locales" vista="admin/cafe.html" controlador="AdminCafeController → CafeService" tablas="cafe_carta* (inserta, actualiza) · cafe_local* (inserta, actualiza) · contenido_web* (actualiza)" id="gen-n28"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F0E8;strokeColor=#5A7A5C;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="1786" width="240" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-19&lt;/b&gt;&lt;br&gt;Gestionar banners y contenido institucional" tooltip="CU-19 · Gestionar banners y contenido institucional&#10;RF: RF11*&#10;Ruta: GET /admin/contenido · POST /admin/contenido/{clave}&#10;Vista: admin/contenido.html&#10;Controlador: AdminContenidoController → ContenidoService&#10;Tablas: contenido_web* (lee, inserta, actualiza)&#10;Lógica: Cambia imágenes y textos del banner de la Home, las campañas, la página Nosotros y las políticas sin modificar código." rf="RF11*" ruta="GET /admin/contenido · POST /admin/contenido/{clave}" vista="admin/contenido.html" controlador="AdminContenidoController → ContenidoService" tablas="contenido_web* (lee, inserta, actualiza)" id="gen-n29"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F0E8;strokeColor=#5A7A5C;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="1864" width="240" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-20&lt;/b&gt;&lt;br&gt;Atender mensajes y suscriptores" tooltip="CU-20 · Atender mensajes y suscriptores&#10;RF: RF12*&#10;Ruta: GET /admin/mensajes · POST /admin/mensajes/{id}/atendido · GET /admin/suscriptores.csv&#10;Vista: admin/mensajes.html&#10;Controlador: AdminMensajesController → ContactoService, BoletinService&#10;Tablas: mensaje_contacto* (lee, actualiza) · suscriptor_boletin* (lee)&#10;Lógica: Revisa las consultas recibidas, las marca como atendidas y descarga la lista de suscriptores activos." rf="RF12*" ruta="GET /admin/mensajes · POST /admin/mensajes/{id}/atendido · GET /admin/suscriptores.csv" vista="admin/mensajes.html" controlador="AdminMensajesController → ContactoService, BoletinService" tablas="mensaje_contacto* (lee, actualiza) · suscriptor_boletin* (lee)" id="gen-n30"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F0E8;strokeColor=#5A7A5C;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="1942" width="240" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CU-21&lt;/b&gt;&lt;br&gt;Consultar panel de pedidos web" tooltip="CU-21 · Consultar panel de pedidos web&#10;RF: RF02, RF04&#10;Ruta: GET /admin/panel?desde=&amp;hasta=&#10;Vista: admin/panel.html&#10;Controlador: AdminPanelController → VentaService, ImpactoService&#10;Tablas: venta (lee) · detalle_venta (lee) · cliente (lee) · donacion (lee)&#10;Lógica: Ve los pedidos web del periodo por estado, el monto vendido y las donaciones generadas. Solo consulta: confirmar o anular pedidos no se hace desde el portal." rf="RF02, RF04" ruta="GET /admin/panel?desde=&amp;hasta=" vista="admin/panel.html" controlador="AdminPanelController → VentaService, ImpactoService" tablas="venta (lee) · detalle_venta (lee) · cliente (lee) · donacion (lee)" id="gen-n31"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F0E8;strokeColor=#5A7A5C;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="gen-lim"><mxGeometry x="50" y="2020" width="240" height="62" as="geometry"/></mxCell></UserObject><mxCell id="gen-e32" value="«extend»" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=open;en
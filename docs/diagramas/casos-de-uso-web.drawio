ntStyle=1;fontSize=20;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="db-n2" value="&lt;b&gt;Actor Supabase Cloud DB:&lt;/b&gt; PostgreSQL compartido: persiste los datos, ejecuta las transacciones y valida unicidad." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#7A6152;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="1300" height="24" as="geometry"/></mxCell><mxCell id="db-n3" value="Portal web HÖSÉG" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fillColor=#FFFFFF;strokeColor=#2C1810;fontColor=#2C1810;container=1;collapsible=0;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="600" y="90" width="330" height="2146" as="geometry"/></mxCell><mxCell id="db-n4" value="Escriben en la base (INSERT / UPDATE)" style="text;html=1;align=left;verticalAlign=middle;fontStyle=3;fontSize=12;fontColor=#7A6152;" vertex="1" parent="db-n3"><mxGeometry x="20" y="28" width="300" height="24" as="geometry"/></mxCell><mxCell id="db-n5" value="&lt;b&gt;Escriben en la base (INSERT / UPDATE)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontStyle=3;fontSize=12;fontColor=#7A6152;" vertex="1" parent="1"><mxGeometry x="20" y="118" width="540" height="24" as="geometry"/></mxCell><UserObject label="&lt;b&gt;CU-07&lt;/b&gt;&lt;br&gt;Registrarse como cliente" tooltip="CU-07 · Registrarse como cliente&#10;RF: RF01&#10;Ruta: GET /registro · POST /registro&#10;Vista: registro.html&#10;Controlador: AuthController → ClienteService (DTO RegistroClienteForm: @NotBlank, @Email, @Size)&#10;Tablas: cliente (lee, inserta)&#10;Lógica: Completa nombre, apellido, documento, email, teléfono, dirección y contraseña; los errores se muestran junto a cada campo (th:errors). Si su email ya existe por una compra anterior, completa ese registro." rf="RF01" ruta="GET /registro · POST /registro" vista="registro.html" controlador="AuthController → ClienteService (DTO RegistroClienteForm: @NotBlank, @Email, @Size)" tablas="cliente (lee, inserta)" id="db-n6"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="db-n3"><mxGeometry x="40" y="65" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="db-n7" value="&lt;b&gt;CU-07 · Registrarse como cliente&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; cliente (lee, inserta)&lt;br&gt;&lt;b&gt;En la base:&lt;/b&gt; Índice único sobre lower(email). Contraseña con BCrypt en password_hash. Cliente histórico sin contraseña: UPDATE en lugar de INSERT." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="151" width="540" height="70" as="geometry"/></mxCell><mxCell id="db-e8" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n7" target="db-n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-08&lt;/b&gt;&lt;br&gt;Enviar mensaje de contacto" tooltip="CU-08 · Enviar mensaje de contacto&#10;RF: RF12*&#10;Ruta: GET /contacto · POST /contacto&#10;Vista: contacto.html&#10;Controlador: ContactoController → ContactoService (DTO MensajeContactoForm)&#10;Tablas: mensaje_contacto* (inserta)&#10;Lógica: Escribe su nombre, email, asunto y mensaje (tallas, pedidos corporativos, personal shopper) y recibe un acuse de recibo." rf="RF12*" ruta="GET /contacto · POST /contacto" vista="contacto.html" controlador="ContactoController → ContactoService (DTO MensajeContactoForm)" tablas="mensaje_contacto* (inserta)" id="db-n9"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="db-n3"><mxGeometry x="40" y="157" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="db-n10" value="&lt;b&gt;CU-08 · Enviar mensaje de contacto&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; mensaje_contacto* (inserta)&lt;br&gt;&lt;b&gt;En la base:&lt;/b&gt; INSERT con estado NUEVO." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="540" height="57" as="geometry"/></mxCell><mxCell id="db-e11" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n10" target="db-n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-09&lt;/b&gt;&lt;br&gt;Suscribirse al boletín Changemaker" tooltip="CU-09 · Suscribirse al boletín Changemaker&#10;RF: RF12*&#10;Ruta: POST /boletin&#10;Vista: fragments/footer.html (formulario)&#10;Controlador: BoletinController → BoletinService&#10;Tablas: suscriptor_boletin* (lee, inserta)&#10;Lógica: Deja su email en el pie de página para recibir campañas, lanzamientos e informes de impacto." rf="RF12*" ruta="POST /boletin" vista="fragments/footer.html (formulario)" controlador="BoletinController → BoletinService" tablas="suscriptor_boletin* (lee, inserta)" id="db-n12"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="db-n3"><mxGeometry x="40" y="249" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="db-n13" value="&lt;b&gt;CU-09 · Suscribirse al boletín Changemaker&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; suscriptor_boletin* (lee, inserta)&lt;br&gt;&lt;b&gt;En la base:&lt;/b&gt; Email único; si ya existía dado de baja, se reactiva." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="342" width="540" height="57" as="geometry"/></mxCell><mxCell id="db-e14" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n13" target="db-n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-12&lt;/b&gt;&lt;br&gt;Recuperar contraseña" tooltip="CU-12 · Recuperar contraseña&#10;RF: RF01&#10;Ruta: GET/POST /recuperar · GET/POST /restablecer?token=&#10;Vista: recuperar.html · restablecer.html&#10;Controlador: RecuperacionController → ClienteService&#10;Tablas: cliente (lee, actualiza) · token_recuperacion* (inserta, actualiza)&#10;Lógica: Pide un enlace con su email, lo abre desde su correo y define una contraseña nueva." rf="RF01" ruta="GET/POST /recuperar · GET/POST /restablecer?token=" vista="recuperar.html · restablecer.html" controlador="RecuperacionController → ClienteService" tablas="cliente (lee, actualiza) · token_recuperacion* (inserta, actualiza)" id="db-n15"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF0E8;strokeColor=#A8501E;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="db-n3"><mxGeometry x="40" y="341" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="db-n16" value="&lt;b&gt;CU-12 · Recuperar contraseña&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; cliente (lee, actualiza) · token_recuperacion* (inserta, actualiza)&lt;br&gt;&lt;b&gt;En la base:&lt;/b&gt; Se guarda el hash del token, no el token. Vence a los 30 minutos y es de un solo uso." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="434" width="540" height="57" as="geometry"/></mxCell><mxCell id="db-e17" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n16" target="db-n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-14&lt;/b&gt;&lt;br&gt;Actualizar datos de cuenta" tooltip="CU-14 · Actualizar datos de cuenta&#10;RF: RF01&#10;Ruta: POST /cuenta/datos · POST /cuenta/contrasena&#10;Vista: cuenta.html (pestaña Mis datos)&#10;Controlador: CuentaController → ClienteService (DTO DatosClienteForm)&#10;Tablas: cliente (actualiza)&#10;Lógica: Edita nombre, teléfono y dirección de envío; cambia su contraseña confirmando la actual. El email es su usuario y no se edita aquí." rf="RF01" ruta="POST /cuenta/datos · POST /cuenta/contrasena" vista="cuenta.html (pestaña Mis datos)" controlador="CuentaController → ClienteService (DTO DatosClienteForm)" tablas="cliente (actualiza)" id="db-n18"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF0E8;strokeColor=#A8501E;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="db-n3"><mxGeometry x="40" y="433" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="db-n19" value="&lt;b&gt;CU-14 · Actualizar datos de cuenta&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; cliente (actualiza)&lt;br&gt;&lt;b&gt;En la base:&lt;/b&gt; UPDATE de su propia fila; la contraseña nueva se guarda con BCrypt." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="526" width="540" height="57" as="geometry"/></mxCell><mxCell id="db-e20" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n19" target="db-n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-15&lt;/b&gt;&lt;br&gt;Confirmar compra" tooltip="CU-15 · Confirmar compra&#10;RF: RF02, RF04&#10;Ruta: POST /carrito/confirmar (exige sesión)&#10;Vista: carrito.html → compra-exito.html&#10;Controlador: CarritoController → VentaService (@Transactional)&#10;Tablas: venta (inserta) · detalle_venta (inserta) · donacion (inserta) · producto (lee) · cliente (lee)&#10;Lógica: Confirma su carrito; en una sola transacción se registran la venta, sus líneas y las donaciones 1:1. Se vacía el carrito y se muestra el código de boleta. El pedido queda PENDIENTE hasta confirmarse el pago: la web no descuenta stock." rf="RF02, RF04" ruta="POST /carrito/confirmar (exige sesión)" vista="carrito.html → compra-exito.html" controlador="CarritoController → VentaService (@Transactional)" tablas="venta (inserta) · detalle_venta (inserta) · donacion (inserta) · producto (lee) · cliente (lee)" id="db-n21"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF0E8;strokeColor=#A8501E;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="db-n3"><mxGeometry x="40" y="550" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="db-n22" value="&lt;b&gt;CU-15 · Confirmar compra&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; venta (inserta) · detalle_venta (inserta) · donacion (inserta) · producto (lee) · cliente (lee)&lt;br&gt;&lt;b&gt;En la base:&lt;/b&gt; Una transacción: venta (origen WEB, estado PENDIENTE) + detalle_venta + donacion (PENDIENTE). Si algo falla se revierte todo.&lt;br&gt;&lt;b&gt;CU-15.1:&lt;/b&gt; producto (lee)&lt;br&gt;&lt;b&gt;CU-15.2:&lt;/b&gt; seq_comprobante_web (nextval) · venta (inserta)&lt;br&gt;&lt;b&gt;CU-15.3:&lt;/b&gt; producto (lee) · donacion (inserta)" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="540" height="122" as="geometry"/></mxCell><mxCell id="db-e23" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n22" target="db-n21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-17&lt;/b&gt;&lt;br&gt;Gestionar destacados y visibilidad web" tooltip="CU-17 · Gestionar destacados y visibilidad web&#10;RF: RF11*&#10;Ruta: GET /admin/catalogo · POST /admin/catalogo/{codigo}&#10;Vista: admin/catalogo.html&#10;Controlador: AdminCatalogoController → CatalogoService&#10;Tablas: producto (lee, actualiza)&#10;Lógica: Elige qué productos aparecen en el carrusel de la Home y oculta de la tienda los que no deben venderse en línea." rf="RF11*" ruta="GET /admin/catalogo · POST /admin/catalogo/{codigo}" vista="admin/catalogo.html" controlador="AdminCatalogoController → CatalogoService" tablas="producto (lee, actualiza)" id="db-n24"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F0E8;strokeColor=#5A7A5C;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="db-n3"><mxGeometry x="40" y="667" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="db-n25" value="&lt;b&gt;CU-17 · Gestionar destacados y visibilidad web&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; producto (lee, actualiza)&lt;br&gt;&lt;b&gt;En la base:&lt;/b&gt; Actualiza solo visible_web y destacado* (columna nueva). Precio y stock no se editan desde la web." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="753" width="540" height="70" as="geometry"/></mxCell><mxCell id="db-e26" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n25" target="db-n24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-18&lt;/b&gt;&lt;br&gt;Gestionar Höség Café" tooltip="CU-18 · Gestionar Höség Café&#10;RF: RF11*&#10;Ruta: GET/POST /admin/cafe/carta · GET/POST /admin/cafe/locales&#10;Vista: admin/cafe.html&#10;Controlador: AdminCafeController → CafeService&#10;Tablas: cafe_carta* (inserta, actualiza) · cafe_local* (inserta, actualiza) · contenido_web* (actualiza)&#10;Lógica: Mantiene la carta (bebidas, precios, disponibilidad), los locales y horarios, y la cifra de árboles sembrados por el café que se publica en /cafe." rf="RF11*" ruta="GET/POST /admin/cafe/carta · GET/POST /admin/cafe/locales" vista="admin/cafe.html" controlador="AdminCafeController → CafeService" tablas="cafe_carta* (inserta, actualiza) · cafe_local* (inserta, actualiza) · contenido_web* (actualiza)" id="db-n27"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F0E8;strokeColor=#5A7A5C;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="db-n3"><mxGeometry x="40" y="759" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="db-n28" value="&lt;b&gt;CU-18 · Gestionar Höség Café&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; cafe_carta* (inserta, actualiza) · cafe_local* (inserta, actualiza) · contenido_web* (actualiza)&lt;br&gt;&lt;b&gt;En la base:&lt;/b&gt; Los ítems se desactivan en lugar de borrarse." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="845" width="540" height="70" as="geometry"/></mxCell><mxCell id="db-e29" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n28" target="db-n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-19&lt;/b&gt;&lt;br&gt;Gestionar banners y contenido institucional" tooltip="CU-19 · Gestionar banners y contenido institucional&#10;RF: RF11*&#10;Ruta: GET /admin/contenido · POST /admin/contenido/{clave}&#10;Vista: admin/contenido.html&#10;Controlador: AdminContenidoController → ContenidoService&#10;Tablas: contenido_web* (lee, inserta, actualiza)&#10;Lógica: Cambia imágenes y textos del banner de la Home, las campañas, la página Nosotros y las políticas sin modificar código." rf="RF11*" ruta="GET /admin/contenido · POST /admin/contenido/{clave}" vista="admin/contenido.html" controlador="AdminContenidoController → ContenidoService" tablas="contenido_web* (lee, inserta, actualiza)" id="db-n30"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F0E8;strokeColor=#5A7A5C;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="db-n3"><mxGeometry x="40" y="851" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="db-n31" value="&lt;b&gt;CU-19 · Gestionar banners y contenido institucional&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; contenido_web* (lee, inserta, actualiza)&lt;br&gt;&lt;b&gt;En la base:&lt;/b&gt; Una fila por bloque de contenido (clave única)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="944" width="540" height="57" as="geometry"/></mxCell><mxCell id="db-e32" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n31" target="db-n30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-20&lt;/b&gt;&lt;br&gt;Atender mensajes y suscriptores" tooltip="CU-20 · Atender mensajes y suscriptores&#10;RF: RF12*&#10;Ruta: GET /admin/mensajes · POST /admin/mensajes/{id}/atendido · GET /admin/suscriptores.csv&#10;Vista: admin/mensajes.html&#10;Controlador: AdminMensajesController → ContactoService, BoletinService&#10;Tablas: mensaje_contacto* (lee, actualiza) · suscriptor_boletin* (lee)&#10;Lógica: Revisa las consultas recibidas, las marca como atendidas y descarga la lista de suscriptores activos." rf="RF12*" ruta="GET /admin/mensajes · POST /admin/mensajes/{id}/atendido · GET /admin/suscriptores.csv" vista="admin/mensajes.html" controlador="AdminMensajesController → ContactoService, BoletinService" tablas="mensaje_contacto* (lee, actualiza) · suscriptor_boletin* (lee)" id="db-n33"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F0E8;strokeColor=#5A7A5C;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="db-n3"><mxGeometry x="40" y="943" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="db-n34" value="&lt;b&gt;CU-20 · Atender mensajes y suscriptores&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; mensaje_contacto* (lee, actualiza) · suscriptor_boletin* (lee)&lt;br&gt;&lt;b&gt;En la base:&lt;/b&gt; Cambia mensaje_contacto.estado de NUEVO a ATENDIDO." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="1036" width="540" height="57" as="geometry"/></mxCell><mxCell id="db-e35" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n34" target="db-n33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="db-n36" value="Solo leen" style="text;html=1;align=left;verticalAlign=middle;fontStyle=3;fontSize=12;fontColor=#7A6152;" vertex="1" parent="db-n3"><mxGeometry x="20" y="1058" width="300" height="24" as="geometry"/></mxCell><mxCell id="db-n37" value="&lt;b&gt;Solo leen&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontStyle=3;fontSize=12;fontColor=#7A6152;" vertex="1" parent="1"><mxGeometry x="20" y="1148" width="540" height="24" as="geometry"/></mxCell><UserObject label="&lt;b&gt;CU-01&lt;/b&gt;&lt;br&gt;Explorar página principal" tooltip="CU-01 · Explorar página principal&#10;RF: RF04&#10;Ruta: GET /&#10;Vista: index.html (fragmentos navbar, footer, product-card)&#10;Controlador: HomeController → CatalogoService, ImpactoService&#10;Tablas: producto (lee) · donacion (lee) · lote_donacion (lee) · comunidad (lee) · venta (lee)&#10;Lógica: Ve el banner de identidad, el carrusel de productos destacados con su badge «1 abrigo» / «1 árbol», las cifras de impacto entregado y las comunidades beneficiadas." rf="RF04" ruta="GET /" vista="index.html (fragmentos navbar, footer, product-card)" controlador="HomeController → CatalogoService, ImpactoService" tablas="producto (lee) · donacion (lee) · lote_donacion (lee) · comunidad (lee) · venta (lee)" id="db-n38"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="db-n3"><mxGeometry x="40" y="1095" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="db-n39" value="&lt;b&gt;CU-01 · Explorar página principal&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; producto (lee) · donacion (lee) · lote_donacion (lee) · comunidad (lee) · venta (lee)&lt;br&gt;&lt;b&gt;En la base:&lt;/b&gt; Solo lectura. Destacados: activo AND visible_web. Cifras: donaciones ENTREGADA por tipo, comunidades con lote ENTREGADO y ventas PAGADO con donación." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="1181" width="540" height="70" as="geometry"/></mxCell><mxCell id="db-e40" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n39" target="db-n38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-02&lt;/b&gt;&lt;br&gt;Explorar catálogo de productos" tooltip="CU-02 · Explorar catálogo de productos&#10;RF: RF03&#10;Ruta: GET /tienda&#10;Vista: tienda.html&#10;Controlador: TiendaController → CatalogoService&#10;Tablas: producto (lee)&#10;Lógica: Recorre casacas, accesorios y café agrupados por nombre, con precio, tallas y compromiso de impacto; los productos sin stock comercial se muestran como «Agotado»." rf="RF03" ruta="GET /tienda" vista="tienda.html" controlador="TiendaController → CatalogoService" tablas="producto (lee)" id="db-n41"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="db-n3"><mxGeometry x="40" y="1187" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="db-n42" value="&lt;b&gt;CU-02 · Explorar catálogo de productos&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; producto (lee)&lt;br&gt;&lt;b&gt;En la base:&lt;/b&gt; Solo lectura. Filtra activo AND visible_web; «Agotado» si stock_comercial = 0.&lt;br&gt;&lt;b&gt;CU-02.1:&lt;/b&gt; producto (lee)" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="1273" width="540" height="70" as="geometry"/></mxCell><mxCell id="db-e43" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n42" target="db-n41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-03&lt;/b&gt;&lt;br&gt;Ver detalle de producto" tooltip="CU-03 · Ver detalle de producto&#10;RF: RF03, RF04&#10;Ruta: GET /tienda/{codigo}&#10;Vista: producto-detalle.html&#10;Controlador: TiendaController → CatalogoService&#10;Tablas: producto (lee)&#10;Lógica: Ve fotos, descripción, precio y las tallas disponibles (cada talla es un código distinto); elige talla y cantidad y ve qué donación genera su compra." rf="RF03, RF04" ruta="GET /tienda/{codigo}" vista="producto-detalle.html" controlador="TiendaController → CatalogoService" tablas="producto (lee)" id="db-n44"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="db-n3"><mxGeometry x="40" y="1279" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="db-n45" value="&lt;b&gt;CU-03 · Ver detalle de producto&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; producto (lee)&lt;br&gt;&lt;b&gt;En la base:&lt;/b&gt; Lee todas las filas con el mismo nombre para armar el selector de tallas." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="1372" width="540" height="57" as="geometry"/></mxCell><mxCell id="db-e46" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n45" target="db-n44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-04&lt;/b&gt;&lt;br&gt;Gestionar carrito de compras" tooltip="CU-04 · Gestionar carrito de compras&#10;RF: RF02&#10;Ruta: GET /carrito · POST /carrito/agregar · POST /carrito/actualizar · POST /carrito/quitar&#10;Vista: carrito.html&#10;Controlador: CarritoController → CarritoService (@SessionScope)&#10;Tablas: producto (lee)&#10;Lógica: Agrega, cambia la cantidad o quita prendas; ve subtotales, total y el impacto que generará. No necesita cuenta: el carrito vive en la sesión HTTP." rf="RF02" ruta="GET /carrito · POST /carrito/agregar · POST /carrito/actualizar · POST /carrito/quitar" vista="carrito.html" controlador="CarritoController → CarritoService (@SessionScope)" tablas="producto (lee)" id="db-n47"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="db-n3"><mxGeometry x="40" y="1371" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="db-n48" value="&lt;b&gt;CU-04 · Gestionar carrito de compras&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; producto (lee)&lt;br&gt;&lt;b&gt;En la base:&lt;/b&gt; Lee precio, activo y stock_comercial al agregar. El carrito no se guarda en la base." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="1464" width="540" height="57" as="geometry"/></mxCell><mxCell id="db-e49" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n48" target="db-n47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-05&lt;/b&gt;&lt;br&gt;Conocer Höség Café" tooltip="CU-05 · Conocer Höség Café&#10;RF: RF04, RF11*&#10;Ruta: GET /cafe&#10;Vista: cafe.html&#10;Controlador: CafeController → CafeService&#10;Tablas: cafe_carta* (lee) · cafe_local* (lee) · contenido_web* (lee) · producto (lee)&#10;Lógica: Conoce la propuesta «por cada taza, un árbol» junto a la ONG Pachamama Raymi; revisa la carta, los locales y horarios, y puede ir a comprar café en grano a la tienda (categoría Café, genera 1 árbol)." rf="RF04, RF11*" ruta="GET /cafe" vista="cafe.html" controlador="CafeController → CafeService" tablas="cafe_carta* (lee) · cafe_local* (lee) · contenido_web* (lee) · producto (lee)" id="db-n50"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="db-n3"><mxGeometry x="40" y="1463" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="db-n51" value="&lt;b&gt;CU-05 · Conocer Höség Café&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; cafe_carta* (lee) · cafe_local* (lee) · contenido_web* (lee) · producto (lee)&lt;br&gt;&lt;b&gt;En la base:&lt;/b&gt; Solo lectura. El café en grano es un producto más (categoria = 'Café', tipo_compromiso = ARBOL): no necesita tabla nueva." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="1549" width="540" height="70" as="geometry"/></mxCell><mxCell id="db-e52" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n51" target="db-n50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-06&lt;/b&gt;&lt;br&gt;Conocer la empresa y su triple impacto" tooltip="CU-06 · Conocer la empresa y su triple impacto&#10;RF: RF04, RF11*&#10;Ruta: GET /nosotros · GET /politica-rsu · GET /terminos&#10;Vista: nosotros.html · politica-rsu.html · terminos.html&#10;Controlador: InstitucionalController → ContenidoService, ImpactoService&#10;Tablas: contenido_web* (lee) · comunidad (lee) · ong (lee)&#10;Lógica: Lee la historia de la marca, los modelos Buy One, Give One y Buy One, Plant One, las comunidades y la ONG aliada, y las políticas de responsabilidad social." rf="RF04, RF11*" ruta="GET /nosotros · GET /politica-rsu · GET /terminos" vista="nosotros.html · politica-rsu.html · terminos.html" controlador="InstitucionalController → ContenidoService, ImpactoService" tablas="contenido_web* (lee) · comunidad (lee) · ong (lee)" id="db-n53"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="db-n3"><mxGeometry x="40" y="1555" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="db-n54" value="&lt;b&gt;CU-06 · Conocer la empresa y su triple impacto&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; contenido_web* (lee) · comunidad (lee) · ong (lee)&lt;br&gt;&lt;b&gt;En la base:&lt;/b&gt; Solo lectura." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="1648" width="540" height="57" as="geometry"/></mxCell><mxCell id="db-e55" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n54" target="db-n53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-10&lt;/b&gt;&lt;br&gt;Consultar impacto por boleta" tooltip="CU-10 · Consultar impacto por boleta&#10;RF: RF04, RF06&#10;Ruta: GET /consulta-impacto?boleta=WEB-000110 · GET /api/impacto?boleta= (AJAX)&#10;Vista: consulta-impacto.html&#10;Controlador: ConsultaImpactoController → ImpactoService&#10;Tablas: venta (lee) · detalle_venta (lee) · donacion (lee) · lote_donacion (lee) · comunidad (lee) · ong (lee)&#10;Lógica: Ingresa el código de su boleta y ve cada abrigo o árbol que generó, su estado (Pendiente de asignar → Lote asignado → Entregada) y la comunidad beneficiada." rf="RF04, RF06" ruta="GET /consulta-impacto?boleta=WEB-000110 · GET /api/impacto?boleta= (AJAX)" vista="consulta-impacto.html" controlador="ConsultaImpactoController → ImpactoService" tablas="venta (lee) · detalle_venta (lee) · donacion (lee) · lote_donacion (lee) · comunidad (lee) · ong (lee)" id="db-n56"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="db-n3"><mxGeometry x="40" y="1659" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="db-n57" value="&lt;b&gt;CU-10 · Consultar impacto por boleta&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; venta (lee) · detalle_venta (lee) · donacion (lee) · lote_donacion (lee) · comunidad (lee) · ong (lee)&lt;br&gt;&lt;b&gt;En la base:&lt;/b&gt; venta.codigo_comprobante → detalle_venta → donacion (índice idx_donacion_detalle) → lote_donacion → comunidad, ong. Solo lectura.&lt;br&gt;&lt;b&gt;CU-10.1:&lt;/b&gt; donacion (lee) · lote_donacion (lee) · comunidad (lee)" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="1732" width="540" height="96" as="geometry"/></mxCell><mxCell id="db-e58" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n57" target="db-n56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-11&lt;/b&gt;&lt;br&gt;Iniciar y cerrar sesión" tooltip="CU-11 · Iniciar y cerrar sesión&#10;RF: RF01&#10;Ruta: GET /login · POST /login · POST /logout&#10;Vista: login.html&#10;Controlador: SecurityConfig (formLogin) → ClienteDetailsService&#10;Tablas: cliente (lee)&#10;Lógica: Ingresa email y contraseña; al validarse, el menú muestra su nombre y se habilitan la compra y su cuenta. El carrito armado como visitante se conserva." rf="RF01" ruta="GET /login · POST /login · POST /logout" vista="login.html" controlador="SecurityConfig (formLogin) → ClienteDetailsService" tablas="cliente (lee)" id="db-n59"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF0E8;strokeColor=#A8501E;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="db-n3"><mxGeometry x="40" y="1763" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="db-n60" value="&lt;b&gt;CU-11 · Iniciar y cerrar sesión&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; cliente (lee)&lt;br&gt;&lt;b&gt;En la base:&lt;/b&gt; Busca por email sin distinguir mayúsculas y compara BCrypt. Un cliente sin password_hash no puede ingresar." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="1849" width="540" height="70" as="geometry"/></mxCell><mxCell id="db-e61" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n60" target="db-n59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-13&lt;/b&gt;&lt;br&gt;Consultar mis pedidos e impacto" tooltip="CU-13 · Consultar mis pedidos e impacto&#10;RF: RF04, RF06&#10;Ruta: GET /cuenta · GET /cuenta/pedidos/{codigo}&#10;Vista: cuenta.html (pestaña Pedidos) · pedido-detalle.html&#10;Controlador: CuentaController → VentaService, ImpactoService&#10;Tablas: venta (lee) · detalle_venta (lee) · donacion (lee) · lote_donacion (lee) · comunidad (lee)&#10;Lógica: Revisa su historial de compras con su estado (Pendiente, Pagado, Anulado), el detalle de cada una y el recorrido de cada donación hasta su comunidad." rf="RF04, RF06" ruta="GET /cuenta · GET /cuenta/pedidos/{codigo}" vista="cuenta.html (pestaña Pedidos) · pedido-detalle.html" controlador="CuentaController → VentaService, ImpactoService" tablas="venta (lee) · detalle_venta (lee) · donacion (lee) · lote_donacion (lee) · comunidad (lee)" id="db-n62"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF0E8;strokeColor=#A8501E;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="db-n3"><mxGeometry x="40" y="1855" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="db-n63" value="&lt;b&gt;CU-13 · Consultar mis pedidos e impacto&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; venta (lee) · detalle_venta (lee) · donacion (lee) · lote_donacion (lee) · comunidad (lee)&lt;br&gt;&lt;b&gt;En la base:&lt;/b&gt; Solo pedidos con id_cliente = cliente autenticado." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="1948" width="540" height="57" as="geometry"/></mxCell><mxCell id="db-e64" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n63" target="db-n62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-16&lt;/b&gt;&lt;br&gt;Iniciar sesión administrativa" tooltip="CU-16 · Iniciar sesión administrativa&#10;RF: RF01&#10;Ruta: GET /admin/login · POST /admin/login · POST /admin/logout&#10;Vista: admin/login.html&#10;Controlador: SecurityConfig (cadena /admin/**) → UsuarioDetailsService&#10;Tablas: usuario (lee)&#10;Lógica: El personal de Höség con rol ADMINISTRADOR entra al panel del portal. Las cuentas de cliente no tienen acceso a /admin." rf="RF01" ruta="GET /admin/login · POST /admin/login · POST /admin/logout" vista="admin/login.html" controlador="SecurityConfig (cadena /admin/**) → UsuarioDetailsService" tablas="usuario (lee)" id="db-n65"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F0E8;strokeColor=#5A7A5C;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="db-n3"><mxGeometry x="40" y="1947" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="db-n66" value="&lt;b&gt;CU-16 · Iniciar sesión administrativa&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; usuario (lee)&lt;br&gt;&lt;b&gt;En la base:&lt;/b&gt; Lee username, password_hash (SHA-256 + salt), rol, activo y bloqueado_hasta. La web solo lee esta tabla." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="20" y="2033" width="540" height="70" as="geometry"/></mxCell><mxCell id="db-e67" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-n66" target="db-n65"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-21&lt;/b&gt;&lt;br&gt;Consultar panel de pedidos web" tooltip="CU-21 · Consultar panel de pedidos web&#10;RF: RF02, RF04&#10;Ruta: GET /admin/panel?desde=&amp;hasta=&#10;Vista: admin/panel.html&#10;Controlador: AdminPanelController → VentaService, ImpactoService&#10;Tablas: venta (lee) · detalle_venta (lee) · cliente (lee) · donacion (lee)&#10;Lógica: Ve los pedidos web del periodo por estado, el monto vendido y las donaciones generadas. Solo consulta: confirmar o anular pedidos no se hace desde el portal." rf="RF02, RF04" ruta="GET /admin/panel?desde=&amp;hasta=" vista="admin/panel.html" controlador="AdminPanelController → VentaService, ImpactoService" tablas="venta (lee) · detalle_venta (lee) · cliente (lee) · donacion (lee)" id="db-n68"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F0E8;strokeColor=#5A7A5C;fontColor=#2
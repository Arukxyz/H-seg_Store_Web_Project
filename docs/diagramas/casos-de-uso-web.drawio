mxPoint x="910" y="547"/><mxPoint x="910" y="816"/></Array></mxGeometry></mxCell><mxCell id="gen-e67" value="" style="endArrow=none;html=1;strokeColor=#7A6152;edgeStyle=none;jumpStyle=arc;jumpSize=8;entryX=1;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen-n63" target="gen-n19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="547"/><mxPoint x="910" y="1170"/></Array></mxGeometry></mxCell><mxCell id="gen-e68" value="" style="endArrow=none;html=1;strokeColor=#7A6152;edgeStyle=none;jumpStyle=arc;jumpSize=8;entryX=1;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen-n63" target="gen-n22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="547"/><mxPoint x="910" y="1404"/></Array></mxGeometry></mxCell><mxCell id="gen-n69" value="«sistema externo»&lt;br&gt;&lt;b&gt;Supabase Cloud DB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PostgreSQL · Supabase&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE6D6;strokeColor=#4A2E20;fontColor=#2C1810;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="1240" width="180" height="74" as="geometry"/></mxCell><mxCell id="gen-e70" value="" style="endArrow=none;html=1;strokeColor=#7A6152;edgeStyle=none;jumpStyle=arc;jumpSize=8;entryX=1;entryY=0.65;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen-n69" target="gen-n13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="1277"/><mxPoint x="950" y="678"/></Array></mxGeometry></mxCell><mxCell id="gen-e71" value="" style="endArrow=none;html=1;strokeColor=#7A6152;edgeStyle=none;jumpStyle=arc;jumpSize=8;entryX=1;entryY=0.65;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen-n69" target="gen-n16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="1277"/><mxPoint x="950" y="912"/></Array></mxGeometry></mxCell><mxCell id="gen-e72" value="" style="endArrow=none;html=1;strokeColor=#7A6152;edgeStyle=none;jumpStyle=arc;jumpSize=8;entryX=1;entryY=0.65;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen-n69" target="gen-n18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="1277"/><mxPoint x="950" y="1110"/></Array></mxGeometry></mxCell><mxCell id="gen-e73" value="" style="endArrow=none;html=1;strokeColor=#7A6152;edgeStyle=none;jumpStyle=arc;jumpSize=8;entryX=1;entryY=0.65;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen-n69" target="gen-n22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="1277"/><mxPoint x="950" y="1422"/></Array></mxGeometry></mxCell><mxCell id="gen-e74" value="" style="endArrow=none;html=1;strokeColor=#7A6152;edgeStyle=none;jumpStyle=arc;jumpSize=8;entryX=1;entryY=0.65;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen-n69" target="gen-n26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="1277"/><mxPoint x="950" y="1760"/></Array></mxGeometry></mxCell><mxCell id="gen-n75" value="&lt;b style=&quot;font-size:13px&quot;&gt;Cómo leer este diagrama&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;───&lt;/b&gt; Asociación: el actor inicia o participa en el caso de uso&lt;br&gt;&lt;b&gt;- - -▷ «include»&lt;/b&gt;: el caso base siempre lo ejecuta&lt;br&gt;&lt;b&gt;- - -▷ «extend»&lt;/b&gt;: comportamiento opcional del caso base&lt;br&gt;&lt;b&gt;───▷&lt;/b&gt; Generalización: el Cliente hereda todo lo del Visitante&lt;br&gt;&lt;br&gt;&lt;b&gt;Colores&lt;/b&gt;: terracota = Visitante · terracota oscuro = Cliente · verde = Administrador&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Requerimientos funcionales&lt;/b&gt;&lt;br&gt;&lt;b&gt;RF01&lt;/b&gt; Gestión de autenticación&lt;br&gt;&lt;b&gt;RF02&lt;/b&gt; Registro de ventas web&lt;br&gt;&lt;b&gt;RF03&lt;/b&gt; Control de stock (lectura de disponibilidad)&lt;br&gt;&lt;b&gt;RF04&lt;/b&gt; Registro de triple impacto&lt;br&gt;&lt;b&gt;RF06&lt;/b&gt; Seguimiento de donaciones&lt;br&gt;&lt;b&gt;RF11*&lt;/b&gt; Gestión de contenido web y Höség Café (propuesto)&lt;br&gt;&lt;b&gt;RF12*&lt;/b&gt; Comunicación con el cliente: contacto, boletín y correos (propuesto)&lt;br&gt;RF05 y RF07–RF10 se cubren fuera del portal web.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Tablas&lt;/b&gt;&lt;br&gt;&lt;b&gt;*&lt;/b&gt; tabla o columna nueva, requiere un script 07: cafe_carta, cafe_local, contenido_web, mensaje_contacto, suscriptor_boletin, token_recuperacion y la columna producto.destacado.&lt;br&gt;&lt;br&gt;&lt;b&gt;Supabase&lt;/b&gt; participa en todo caso que lee o escribe datos; aquí solo se enlaza a los que validan credenciales o hacen transacciones. Su página individual muestra todos.&lt;br&gt;&lt;br&gt;&lt;i&gt;Pasa el cursor sobre un caso de uso para ver su ruta, vista, controlador y tablas. Las notas completas están en las páginas 2 a 6.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=11;fillColor=#F5F0E8;strokeColor=#D9CEB8;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="1240" y="90" width="460" height="400" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 · Visitante" id="vis"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="vis-n1" value="Casos de uso del Visitante · navegación y consulta pública" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="vis-n2" value="&lt;b&gt;Actor Visitante:&lt;/b&gt; Cualquier persona que entra al portal sin iniciar sesión." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#7A6152;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1300" height="24" as="geometry"/></mxCell><mxCell id="vis-n3" value="Portal web HÖSÉG" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fillColor=#FFFFFF;strokeColor=#2C1810;fontColor=#2C1810;container=1;collapsible=0;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="200" y="90" width="610" height="1955" as="geometry"/></mxCell><UserObject label="&lt;b&gt;CU-01&lt;/b&gt;&lt;br&gt;Explorar página principal" tooltip="CU-01 · Explorar página principal&#10;RF: RF04&#10;Ruta: GET /&#10;Vista: index.html (fragmentos navbar, footer, product-card)&#10;Controlador: HomeController → CatalogoService, ImpactoService&#10;Tablas: producto (lee) · donacion (lee) · lote_donacion (lee) · comunidad (lee) · venta (lee)&#10;Lógica: Ve el banner de identidad, el carrusel de productos destacados con su badge «1 abrigo» / «1 árbol», las cifras de impacto entregado y las comunidades beneficiadas." rf="RF04" ruta="GET /" vista="index.html (fragmentos navbar, footer, product-card)" controlador="HomeController → CatalogoService, ImpactoService" tablas="producto (lee) · donacion (lee) · lote_donacion (lee) · comunidad (lee) · venta (lee)" id="vis-n4"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="vis-n3"><mxGeometry x="30" y="90" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="vis-n5" value="&lt;b&gt;CU-01 · Explorar página principal&lt;/b&gt;&lt;br&gt;&lt;b&gt;RF:&lt;/b&gt; RF04&lt;br&gt;&lt;b&gt;Vista:&lt;/b&gt; index.html (fragmentos navbar, footer, product-card)&lt;br&gt;&lt;b&gt;Ruta:&lt;/b&gt; GET /&lt;br&gt;&lt;b&gt;Controlador:&lt;/b&gt; HomeController → CatalogoService, ImpactoService&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; producto (lee) · donacion (lee) · lote_donacion (lee) · comunidad (lee) · venta (lee)&lt;br&gt;&lt;b&gt;Lógica:&lt;/b&gt; Ve el banner de identidad, el carrusel de productos destacados con su badge «1 abrigo» / «1 árbol», las cifras de impacto entregado y las comunidades beneficiadas." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FEF3DC;strokeColor=#D4820A;fontColor=#2C1810;" vertex="1" parent="1"><mxGeometry x="860" y="150" width="540" height="122" as="geometry"/></mxCell><mxCell id="vis-e6" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D4820A;" edge="1" parent="1" source="vis-n5" target="vis-n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject label="&lt;b&gt;CU-02&lt;/b&gt;&lt;br&gt;Explorar catálogo de productos" tooltip="CU-02 · Explorar catálogo de productos&#10;RF: RF03&#10;Ruta: GET /tienda&#10;Vista: tienda.html&#10;Controlador: TiendaController → CatalogoService&#10;Tablas: producto (lee)&#10;Lógica: Recorre casacas, accesorios y café agrupados por nombre, con precio, tallas y compromiso de impacto; los productos sin stock comercial se muestran como «Agotado»." rf="RF03" ruta="GET /tienda" vista="tienda.html" controlador="TiendaController → CatalogoService" tablas="producto (lee)" id="vis-n7"><mxCell style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDFAF5;strokeColor=#C4622D;fontColor=#2C1810;strokeWidth=1.5;fontSize=11;" vertex="1" parent="vis-n3"><mxGeometry x="30" y="234" width="250" height="62" as="geometry"/></mxCell></UserObject><mxCell id="vis-n8" value="&lt;b&gt;CU-02 · Explorar catálogo de productos&lt;/b&gt;&lt;br&gt;&lt;b&gt;RF:&lt;/b&gt; RF03&lt;br&gt;&lt;b&gt;Vista:&lt;/b&gt; tienda.html&lt;br&gt;&lt;b&gt;Ruta:&lt;/b&gt; GET /tienda&lt;br&gt;&lt;b&gt;Controlador:&lt;/b&gt; TiendaController → CatalogoService&lt;br&gt;&lt;b&gt;Tablas:&lt;/b&gt; producto (lee)&lt;br&gt;&lt;b&gt;Lógica:&lt;/b&gt; Recorre casacas, accesorios y café agrupados por nombre, con precio, tallas y compromiso de impacto; los productos sin stock comercial se muestran como «Agotado»." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=t